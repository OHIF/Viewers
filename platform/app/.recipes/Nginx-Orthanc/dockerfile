# syntax=docker/dockerfile:1.7-labs
# Nginx + Orthanc recipe: the viewer served by a stock nginx that also proxies
# /pacs/ to the Orthanc container (see docker-compose.yml and config/nginx.conf).
#
# The build context is the repository root (docker-compose.yml sets it), so
# every COPY below is relative to the root, and the root .dockerignore applies.
#
# STAGE 1 IS A VERBATIM COPY of the `builder` stage in the root Dockerfile,
# except for the two lines marked "recipe:". Keep the two in sync: when the
# root build steps change (Node version, pnpm version, install layout), copy
# them here again. This recipe fell three years behind once (Node 20 + yarn
# after the repo had moved to pnpm) and silently served a stale image.

# Stage 1: Build the application
FROM node:24.15.0-slim as builder

RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@12

RUN mkdir /usr/src/app
WORKDIR /usr/src/app
ENV PATH=/usr/src/app/node_modules/.bin:$PATH

# Copy package manifests for install caching. preinstall.js is included because
# the root package.json's "preinstall" lifecycle script (node preinstall.js)
# runs during `pnpm install` below -- before the full source is copied -- so the
# script file must already be present or install fails with MODULE_NOT_FOUND.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc preinstall.js ./
COPY --parents ./extensions/*/package.json ./modes/*/package.json ./platform/*/package.json ./
# Run the install before copying the rest of the files.
# Frozen, like CI, so the image installs exactly the reviewed lockfile --
# transitive versions and integrity hashes included -- and never re-resolves
# against the registry. pnpm 12 requires a manifest for every importer the
# lockfile records, so .dockerignore lets platform/docs/package.json in; the
# filter then skips installing the docs site itself.
RUN pnpm install --frozen-lockfile --filter '!ohif-docs'
# Copy the local directory
COPY --link --exclude=pnpm-lock.yaml --exclude=package.json --exclude=Dockerfile . .

# Build here
# After install it should hopefully be stable until the local directory changes
ENV QUICK_BUILD true
# ENV GENERATE_SOURCEMAP=false
# recipe: the viewer config that points the data source at the /pacs/ proxy.
ARG APP_CONFIG=config/docker-nginx-orthanc.js
ARG PUBLIC_URL=/
ENV PUBLIC_URL=${PUBLIC_URL}

RUN pnpm run show:config
RUN pnpm run build

# recipe: the root Dockerfile precompresses dist here (.docker/compressDist.sh),
# which gzips each asset in place and leaves an empty file under the original
# name. The root image serves the .gz files through `gzip_static always`; this
# recipe's config/nginx.conf compresses dynamically (`gzip on`) and has no
# gzip_static, so precompressed output would be served as empty files. Skipped.

# Stage 2: Bundle the built application into a Docker container which runs NGINX using Alpine Linux
# Same nginx line as the root Dockerfile, but the stock image rather than
# nginxinc/nginx-unprivileged: this is a local development recipe whose
# config/nginx.conf listens on 80 as root and is mounted at runtime, so it
# skips the unprivileged hardening the published ohif/app image carries.
FROM nginx:1.27-alpine

# Create directories for logs and html content if they don't already exist
RUN mkdir -p /var/log/nginx /var/www/html

# Copy build output to serve static files
COPY --from=builder /usr/src/app/platform/app/dist /var/www/html

# Expose HTTP and HTTPS ports
EXPOSE 80 443

# Start NGINX
CMD ["nginx", "-g", "daemon off;"]
