// URL-loaded customization: volumeProjectionOrder
//
// Problem: the slices of a volume must be in spatial order. OHIF's default
// order sorts by position only when the display set is reconstructable, and
// else falls back to InstanceNumber, which does not always follow the
// position.
//
// Fix: order the slices of every `volume3d` display set by their distance
// along the normal of the image plane, from one origin for the whole series.
//
// How it works:
//  - The module replaces the default `volume3d` rule under its own id, so the
//    rule keeps its place (priority 4) and claims the same instances. The
//    `matches` are those of the default rule.
//  - `sliceDistance` is an alias of the default display set context for the
//    group `planeGeometry` (the built-in series function). It picks the
//    origin and the normal once for the series, and gives the distance of
//    each slice from the origin. The origin does not depend on the order in
//    which the instances arrive.
//  - `sortBy` orders the slices by that distance. An image that is not in the
//    dominant plane has no distance, so it goes after the images that have
//    one.
//
// Series that this module changes: the order of the images of CT, MR, PT and
// NM series that `volume3d` claims. The grouping does not change.
//
// Load it with `?customization=split/volumeProjectionOrder`.
{
  "requires": ["split/enableNewSplit"],
  "global": {
    "useMetadataDisplaySet": {
      "splitRules": {
        "$merge": {
          "volume3d": {
            "priority": 4,
            "description": "Multi-slice CT / MR / PT / NM, as the default volume3d rule, in the order of the distance along the normal.",
            "viewportTypes": ["volume", "volume3d", "stack"],
            "matches": {
              "isStackImage": true,
              "Modality": ["CT", "MR", "PT", "NM"],
              "seriesInstanceCount": { "greaterThan": 1 },
              "isImage": true,
              "Rows": { "notNull": true }
            },
            "groupBy": ["SeriesInstanceUID"],
            "sortBy": ["sliceDistance"]
          }
        }
      }
    }
  }
}
