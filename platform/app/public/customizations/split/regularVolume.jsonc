// URL-loaded customization: regularVolume
//
// Problem: a CT, MR, PT or NM series is a volume, except for some images that
// are not on the regular slice spacing - an extra slice, a slice at another
// angle, or a re-acquired slice between two positions. The default `volume3d`
// rule puts all of them in one display set, which is then not reconstructable,
// so MPR is not available.
//
// Fix: the regular slices become one volume display set. The other images
// stay with the default rules, as if this module were not loaded.
//
// How it works:
//  - The default display set context has the group `planeGeometry` (the
//    built-in series function): the dominant image plane, the slice spacing
//    (the most frequent gap), and the lattice index of each regular slice.
//    `sliceIndex`, `sliceDistance` and `sliceSpacing` are its aliases.
//  - The rule `context` defines `mixesIrregular`: the series has a complete
//    regular lattice of 3 or more slices, and also other images. Remove
//    `&& planeGeometry.complete` to accept a lattice with a missing slice.
//    `isRegularSlice` is true when the instance has a lattice index. The test
//    is `!= null`, because the index 0 is a valid index.
//  - `matches` claims an instance only when the series mixes the two kinds,
//    and the instance is a regular slice.
//  - `sortBy` orders the slices by their distance along the normal. The
//    `displaySet.` prefix reads the value of the display set; a bare name reads
//    the value of the series.
//  - `attributes` adds the spacing of the display set to the SeriesDescription.
//  - `irregularImages` is off (priority null). With priority -1 it puts the
//    other images into one stack. Both rules read the same `planeGeometry`
//    group, so the engine computes it once for each series.
//
// Series that this module changes: only series that mix a regular lattice with
// other images. A fully regular series, and a series with no lattice, keep the
// default display sets.
//
// Load it with `?customization=split/regularVolume`.
{
  "requires": ["split/enableNewSplit"],
  "global": {
    "useMetadataDisplaySet": {
      "splitRules": {
        "$merge": {
          "regularVolume": {
            "priority": -2,
            "description": "Volume series with some irregular images: the regular slices become one volume display set.",
            "viewportTypes": ["volume", "volume3d", "stack"],
            "context": {
              "mixesIrregular": "planeGeometry.regularCount >= 3 && planeGeometry.irregularCount > 0 && planeGeometry.complete",
              "isRegularSlice": "sliceIndex != null"
            },
            "matches": {
              "isImage": true,
              "Modality": ["CT", "MR", "PT", "NM"],
              "mixesIrregular": true,
              "isRegularSlice": true
            },
            "groupBy": ["SeriesInstanceUID"],
            "sortBy": ["displaySet.sliceDistance"],
            "attributes": {
              "SeriesDescription": { "template": "{SeriesDescription} ({displaySet.sliceSpacing} mm)" }
            }
          },
          "irregularImages": {
            "priority": null,
            "description": "Off. With priority -1: the images that regularVolume leaves become one stack.",
            "viewportTypes": ["stack"],
            "context": {
              "mixesIrregular": "planeGeometry.regularCount >= 3 && planeGeometry.irregularCount > 0 && planeGeometry.complete",
              "isRegularSlice": "sliceIndex != null"
            },
            "matches": {
              "isImage": true,
              "Modality": ["CT", "MR", "PT", "NM"],
              "mixesIrregular": true,
              "isRegularSlice": false
            },
            "groupBy": ["SeriesInstanceUID"],
            "attributes": {
              "SeriesDescription": { "template": "{SeriesDescription} (other images)" }
            }
          }
        }
      }
    }
  }
}
