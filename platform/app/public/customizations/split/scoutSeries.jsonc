// URL-loaded customization: scoutSeries
//
// Example of a custom split rule for the metadata-driven display set splitter,
// written as @cornerstonejs/metadata raw selector data (the same safe-function
// vocabulary the default rules use).
//
// Splits the localizer (scout) images of a CT series into their own display
// set labelled "SCOUT". The rest of the series still matches the default
// volume/stack rules and forms its own display set.
//
// How it works:
//  - `requires` loads split/enableNewSplit first, turning the splitter on.
//  - `displaySetRules` is the registry, keyed by rule id, so `$merge` adds the
//    rule under its id. `displaySetRuleOrder` lists the rule ids in
//    evaluation order, with first-match-wins per instance. `$spliceById` puts
//    the scout rule just before the default `localizer` rule. A server that
//    registers `spliceById` of @cornerstonejs/metadata gets the same order, and
//    a server without the command gets an error. So for CT this module replaces
//    the default `localizer` rule: the scout display set has `splitRuleId`
//    `ctScout`, the "SCOUT" label and description, and `isLocalizer: true`, as
//    the `localizer` display set has. The rule has no `Rows` test, unlike the
//    `localizer` rule. To turn a rule off, remove its id from the order (for
//    example `{ "$spliceById": [["volume3d", 1]] }`).
//  - `isLocalizer` (ImageType holds LOCALIZER) is a name of the default
//    context. The rule `context` defines `hasScout`, for this rule only: a
//    series value that is true when the series MIXES localizer and
//    non-localizer images. A series of localizers only, or a series with none,
//    is left whole.
//  - `matches` claims the localizer images of a CT series that has a scout.
//  - `attributes` sets a fixed label, `isLocalizer: true` (so a hanging
//    protocol that excludes localizers also excludes the scout),
//    `isReconstructable: false` (scouts never open as a volume), and builds
//    the SeriesDescription overlay text with a template.
//
// Load it with `?customization=split/scoutSeries`.
{
  "requires": ["split/enableNewSplit"],
  "global": {
    "useMetadataDisplaySet": {
      "displaySetRules": {
        "$merge": {
          "ctScout": {
            "context": {
              "hasScout": "series.instances.count(isLocalizer) > 0 && series.instances.count(isLocalizer) < series.instances.count()"
            },
            "matches": {
              "Modality": "CT",
              "hasScout": true,
              "isLocalizer": true
            },
            "groupBy": ["SeriesInstanceUID"],
            "attributes": {
              "label": { "template": "SCOUT" },
              "isLocalizer": true,
              "isReconstructable": false,
              "SeriesDescription": { "template": "SCOUT {SeriesDescription}" }
            }
          }
        }
      },
      "displaySetRuleOrder": { "$spliceById": [["localizer", 0, "ctScout"]] }
    }
  }
}
