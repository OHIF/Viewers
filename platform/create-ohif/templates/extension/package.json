{
  "name": "{{name}}",
  "version": "0.0.1",
  "description": "{{description}}",
  "license": "MIT",
  "keywords": [
    "ohif-extension"
  ],
  "main": "dist/index.umd.js",
  "module": "src/index.tsx",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "public",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.umd.js",
    "module": "dist/index.umd.js"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development rspack build --config .rspack/rspack.prod.js --watch",
    "build": "cross-env NODE_ENV=production rspack build --config .rspack/rspack.prod.js",
    "build:package": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit:ci": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@ohif/core": "{{peerRange}}",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cross-env": "7.0.3",
    "css-loader": "6.11.0",
    "postcss": "8.5.28",
    "postcss-loader": "8.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "style-loader": "4.0.0",
    "tailwindcss": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
